# TCP Planner Environment Variables
# Copy this file to .env.local and fill in your values

# ==============================================================================
# REQUIRED
# ==============================================================================

# Mapbox Token (for map display and geocoding)
NEXT_PUBLIC_MAP_TOKEN=pk.your-mapbox-token-here

# Backend API URL (FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:5555

# ==============================================================================
# OPTIONAL / DEPRECATED
# ==============================================================================

# RAG Embedding Search (DEPRECATED - not needed for Phase 1)
# The rules engine now handles all numeric values deterministically.
# OpenAI was previously used for semantic search embeddings but is no longer required.
# OPENAI_API_KEY=sk-your-api-key-here

# Note: Anthropic API key is set in backend/.env only (for Claude vision photo extraction)

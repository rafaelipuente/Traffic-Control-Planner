# TCP Planner Environment Variables
# Copy this file to .env.local and fill in your values

# Mapbox Token (for map display and geocoding)
NEXT_PUBLIC_MAP_TOKEN=pk.your-mapbox-token-here

# Backend API URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:5555

# Optional: OpenAI for RAG search (narrative generation only, not numeric values)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic API for Claude vision (backend uses this, not frontend)
# ANTHROPIC_API_KEY is set in backend/.env only

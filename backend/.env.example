# Database connection
DATABASE_URL=postgresql://tcp_user:tcp_password@localhost:5432/tcp_db

# JWT secrets (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic API for Claude vision
ANTHROPIC_API_KEY=sk-ant-your-key-here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3333,http://localhost:3000

# Environment
ENVIRONMENT=development

# Optional: Object storage for photos/PDFs (Phase 1 uses filesystem)
# S3_BUCKET=tcp-uploads
# S3_REGION=us-west-2
